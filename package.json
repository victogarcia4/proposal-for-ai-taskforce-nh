{
  "name": "north-harris-ai-task-force-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Human-led North Harris AI norms consultation with Supabase and institutional access controls.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "dev:netlify": "vite dev --mode netlify --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "export:lovable": "node scripts/export-lovable.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
