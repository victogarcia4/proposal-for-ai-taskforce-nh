# Only the publishable key belongs in browser settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Store in Netlify environment settings, never in browser code.
SUPABASE_SECRET_KEY=
# Email-code authentication is configured in Supabase Auth; no Azure tenant is required.
# The legacy GitHub/Blobs data endpoints are retired (HTTP 410).
